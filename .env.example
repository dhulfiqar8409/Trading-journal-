# Darkpools environment. Copy to .env and fill in real values.
# docker compose reads this file for the app service and for ${...} interpolation.

# --- Database -----------------------------------------------------------------
# Password of the PostgreSQL role used by the app. Used by the db service in
# docker-compose.yml to initialise the database, and to build DATABASE_URL.
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# Connection string used by Prisma. With docker compose the app service always
# connects to the bundled db service, so this value is only used when running
# the app outside Docker (local development).
DATABASE_URL=postgresql://darkpools:darkpools@127.0.0.1:5432/darkpools

# --- Sessions -----------------------------------------------------------------
# Secret used to sign session cookies. At least 32 characters. Generate one with:
#   openssl rand -base64 48
SESSION_SECRET=change-me-to-at-least-32-random-characters

# --- First-run protection -------------------------------------------------------
# The first-run page /setup (which creates the admin account) only works for
# requests carrying this token (?token=...), so nobody else can claim a fresh
# deployment. Print it from the server setup and open
# https://<host>/setup?token=<value> once. In production it is required and must
# be at least 16 characters (openssl rand -hex 16); without it /setup answers 503
# and the server logs one line at start-up. In development, unset or empty keeps
# /setup open until the admin account exists. There is no self-enrollment: the
# admin creates every other account under /admin/users.
SETUP_TOKEN=

# --- Request origin -------------------------------------------------------------
# The origin browsers must present on state-changing requests (imports, uploads,
# import presets, the share target): scheme and host, no path. Production:
# https://darkpools.deeapps.net. Unset, the app derives it from the request's Host
# and X-Forwarded-Proto headers, which is fine for local development.
APP_ORIGIN=

# --- Files --------------------------------------------------------------------
# Directory where trade screenshots are stored. Inside the Docker image this is
# /app/uploads (a named volume in docker-compose.yml).
UPLOAD_DIR=./uploads

# Screenshot storage allowed per account, in megabytes (attached screenshots plus
# shared ones still waiting for a trade). Defaults to 200.
ATTACHMENT_QUOTA_MB=200

# --- Networking ---------------------------------------------------------------
# Host port that docker compose publishes the app on (bound to 127.0.0.1 only;
# the reverse proxy on the server forwards to it).
APP_PORT=3300
