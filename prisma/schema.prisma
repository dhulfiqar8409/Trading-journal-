// Darkpools data model. Every record hangs off a User so that queries can be
// scoped by userId even though v1 only ever has a single owner account.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AssetClass {
  STOCK
  OPTION
  FUTURES
  FOREX
  CRYPTO
}

enum Side {
  LONG
  SHORT
}

enum TradeStatus {
  OPEN
  CLOSED
}

enum TagKind {
  STRATEGY
  SETUP
  MISTAKE
  CUSTOM
}

enum DisplayMode {
  R
  USD
}

enum RuleKind {
  MAX_TRADES_PER_DAY
  MAX_DAILY_LOSS_R
  MAX_DAILY_LOSS_USD
  NO_TRADES_BEFORE
  NO_TRADES_AFTER
  STOP_REQUIRED
  MAX_RISK_PER_TRADE_R
  MAX_POSITION_SIZE
  CUSTOM
}

enum RuleEventStatus {
  FOLLOWED
  BROKEN
  OVERRIDDEN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  timeZone     String      @default("UTC")
  displayMode  DisplayMode @default(R)
  createdAt    DateTime    @default(now())

  accounts Account[]
  trades   Trade[]
  tags     Tag[]
  rules    Rule[]
  days     Day[]
}

model Account {
  id        String   @id @default(cuid())
  userId    String
  name      String
  broker    String?
  currency  String   @default("USD")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades Trade[]

  @@index([userId])
}

model Trade {
  id          String      @id @default(cuid())
  userId      String
  accountId   String
  symbol      String
  assetClass  AssetClass  @default(STOCK)
  side        Side
  quantity    Decimal     @db.Decimal(20, 8)
  entryPrice  Decimal     @db.Decimal(20, 8)
  exitPrice   Decimal?    @db.Decimal(20, 8)
  multiplier  Decimal     @default(1) @db.Decimal(20, 8)
  fees        Decimal     @default(0) @db.Decimal(20, 8)
  entryAt     DateTime
  exitAt      DateTime?
  status      TradeStatus @default(OPEN)
  pnl         Decimal?    @db.Decimal(20, 8)
  stopPrice   Decimal?    @db.Decimal(20, 8)
  targetPrice Decimal?    @db.Decimal(20, 8)
  rMultiple   Decimal?    @db.Decimal(20, 8)
  /** Money at risk to the planned stop: |entry - stop| x qty x multiplier (the size of 1R). */
  plannedRisk Decimal?    @db.Decimal(20, 8)
  notes       String      @default("")
  rating      Int?
  mistakes    String?
  importHash  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  account     Account      @relation(fields: [accountId], references: [id])
  tags        Tag[]
  attachments Attachment[]
  ruleEvents  RuleEvent[]

  @@unique([userId, importHash])
  @@index([userId, entryAt])
  @@index([userId, symbol])
  @@index([userId, status])
  @@index([accountId])
}

model Tag {
  id        String   @id @default(cuid())
  userId    String
  name      String
  kind      TagKind  @default(CUSTOM)
  color     String   @default("#6b7280")
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades Trade[]

  @@unique([userId, name])
  @@index([userId])
}

model Attachment {
  id         String   @id @default(cuid())
  tradeId    String
  filename   String
  storedName String   @unique
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@index([tradeId])
}

model Rule {
  id        String   @id @default(cuid())
  userId    String
  title     String
  kind      RuleKind
  /** Numeric parameter (trades, R, currency, size) for kinds that need one. */
  value     Decimal? @db.Decimal(20, 8)
  /** "HH:mm" wall time in the owner's zone for NO_TRADES_BEFORE / NO_TRADES_AFTER. */
  timeValue String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  events RuleEvent[]

  @@index([userId])
}

model RuleEvent {
  id            String          @id @default(cuid())
  tradeId       String
  ruleId        String
  status        RuleEventStatus
  justification String?
  createdAt     DateTime        @default(now())

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  rule  Rule  @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([tradeId, ruleId])
  @@index([ruleId])
}

model Day {
  id              String    @id @default(cuid())
  userId          String
  /** "YYYY-MM-DD" in the owner's zone. */
  date            String
  maxTrades       Int?
  maxLossR        Decimal?  @db.Decimal(20, 8)
  allowedSetupIds String[]  @default([])
  focusNote       String?
  mood            Int?
  sleepHours      Decimal?  @db.Decimal(4, 1)
  focus           Int?
  energy          Int?
  checkedInAt     DateTime?
  wentRight       String?
  wentWrong       String?
  oneChange       String?
  reviewedAt      DateTime?
  dayTags         String[]  @default([])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}
