#!/usr/bin/env bash
# Deploys the newest published Darkpools build, then exits.
#
# Builds are the public image ghcr.io/dhulfiqar8409/darkpools:latest, produced by the
# "Release image" GitHub Actions workflow. Docker is not installed on this host: crane
# exports the image filesystem and only its /app directory (the Next.js standalone
# server plus the Prisma CLI for migrations) is kept, under /var/www/darkpools/releases.
#
# Usage: darkpools-update [--retry]   (--retry re-attempts a build that failed earlier)
set -euo pipefail

IMAGE="${DARKPOOLS_IMAGE:-ghcr.io/dhulfiqar8409/darkpools:latest}"
BASE="/var/www/darkpools"
RELEASES="$BASE/releases"
SHARED="$BASE/shared"
CURRENT="$BASE/current"
SERVICE="darkpools"
HEALTH_URL="http://127.0.0.1:3300/api/health"
KEEP=2

log() { echo "[darkpools-update] $*"; }

exec 9>"/run/lock/darkpools-update.lock"
flock -n 9 || { log "another update is already running"; exit 0; }

command -v crane >/dev/null || { log "crane is not installed"; exit 1; }
[ -f "$SHARED/.env" ] || { log "missing $SHARED/.env"; exit 1; }
mkdir -p "$RELEASES"

if [ "${1:-}" = "--retry" ]; then rm -f "$RELEASES"/*/FAILED 2>/dev/null || true; fi

digest="$(crane digest "$IMAGE" 2>/dev/null)" || { log "cannot read the digest of $IMAGE; will try again later"; exit 0; }
short="${digest#sha256:}"; short="${short:0:12}"
target="$RELEASES/$short"

if [ -L "$CURRENT" ] && [ -f "$CURRENT/DIGEST" ] && [ "$(cat "$CURRENT/DIGEST")" = "$digest" ]; then
  exit 0   # already running this build
fi
if [ -f "$target/FAILED" ]; then
  log "build $short failed earlier; waiting for a new build (or run with --retry)"
  exit 0
fi

log "new build $short, downloading"
rm -rf "$target" "$RELEASES/.tmp"
mkdir -p "$RELEASES/.tmp"
# Layer tars name entries "app/..." (Docker/BuildKit); fall back to "./app/..." just in case.
if ! { crane export "$IMAGE" - | tar -x -C "$RELEASES/.tmp" --strip-components=1 app; } 2>/dev/null \
   || [ ! -f "$RELEASES/.tmp/server.js" ]; then
  rm -rf "$RELEASES/.tmp"; mkdir -p "$RELEASES/.tmp"
  crane export "$IMAGE" - | tar -x -C "$RELEASES/.tmp" --strip-components=2 ./app || true
fi
if [ ! -f "$RELEASES/.tmp/server.js" ]; then
  log "bundle is missing server.js; top-level entries of the image were:"
  crane export "$IMAGE" - | tar -t | cut -d/ -f1 | sort -u | head -30 || true
  rm -rf "$RELEASES/.tmp"
  exit 1
fi
printf '%s\n' "$digest" > "$RELEASES/.tmp/DIGEST"
rm -f "$RELEASES/.tmp/docker-entrypoint.sh"
chown -R www-data:www-data "$RELEASES/.tmp"
mv "$RELEASES/.tmp" "$target"

log "applying database migrations"
set -a; . "$SHARED/.env"; set +a
export CHECKPOINT_DISABLE=1 PRISMA_HIDE_UPDATE_MESSAGE=1
if ! ( cd "$target" && /usr/bin/node prisma-cli/node_modules/prisma/build/index.js migrate deploy --config prisma.config.ts ); then
  log "migrations failed for $short; the running build is untouched"
  touch "$target/FAILED"
  exit 1
fi

previous=""
if [ -L "$CURRENT" ]; then previous="$(readlink -f "$CURRENT")"; fi
ln -sfn "$target" "$CURRENT"
systemctl restart "$SERVICE"

healthy=0
for _ in $(seq 1 30); do
  sleep 2
  if curl -fsS --max-time 3 "$HEALTH_URL" >/dev/null 2>&1; then healthy=1; break; fi
done

if [ "$healthy" = 1 ]; then
  log "deployed $short and healthy"
  # Keep the newest $KEEP releases; never remove the one in use.
  ls -1dt "$RELEASES"/*/ 2>/dev/null | tail -n +$((KEEP + 1)) | while read -r dir; do
    [ "$(readlink -f "$dir")" = "$(readlink -f "$CURRENT")" ] || rm -rf "$dir"
  done
  exit 0
fi

log "health check failed after deploying $short"
journalctl -u "$SERVICE" -n 40 --no-pager || true
touch "$target/FAILED"
if [ -n "$previous" ] && [ -d "$previous" ] && [ "$previous" != "$target" ]; then
  log "rolling back to $(basename "$previous")"
  ln -sfn "$previous" "$CURRENT"
  systemctl restart "$SERVICE"
fi
exit 1
